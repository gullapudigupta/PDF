{
  "manifest_version": 2,
  "name": "PDF Viewer & Editor",
  "version": "0.1.0",
  "description": "View and edit PDF files directly in your browser",
  "permissions": [
    "storage",
    "downloads",
    "file:///*"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_security_policy": "script-src 'self'; object-src 'self'"
}
