{
  "name": "pdf-viewer-editor",
  "version": "0.1.0",
  "main": "electron/main.js",
  "private": true,
  "description": "PDF Viewer & Editor (Electron + Angular + WebExtensions)",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "install:tests": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-for-tests.ps1",
    "test": "ng test",
    "test:coverage": "ng test --watch=false --code-coverage",
    "test:extension": "node --test extension/extension-flow.test.js",
    "test:logged": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-tests-logged.ps1",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "postinstall": "node scripts/copy-pdfjs-worker.js",
    "electron:serve": "npm run build:dev && electron electron/main.js",
    "build:desktop": "ng build --configuration production,desktop",
    "electron:build": "npm run build:desktop && electron-builder",
    "electron:build:win": "npm run build:desktop && electron-builder --win nsis zip",
    "electron:build:mac": "npm run build:desktop && electron-builder --mac dmg zip",
    "electron:build:linux": "npm run build:desktop && electron-builder --linux AppImage",
    "build:dev": "ng build --configuration development",
    "extension:build:chrome": "ng build --configuration extension && node scripts/build-extension.js chrome",
    "extension:build:firefox": "ng build --configuration extension && node scripts/build-extension.js firefox",
    "extension:build": "ng build --configuration extension && node scripts/build-extension.js chrome && node scripts/build-extension.js firefox"
  },
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/localize": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@cantoo/pdf-lib": "2.11.1",
    "@ngrx/effects": "^21.1.1",
    "@ngrx/entity": "^21.1.1",
    "@ngrx/store": "^21.1.1",
    "@ngrx/store-devtools": "^21.1.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^4.5.136",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular-eslint/builder": "^22.0.0",
    "@angular-eslint/eslint-plugin": "^22.0.0",
    "@angular-eslint/eslint-plugin-template": "^22.0.0",
    "@angular-eslint/schematics": "^22.0.0",
    "@angular-eslint/template-parser": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "archiver": "5.3.2",
    "electron": "^27.3.11",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.2.0",
    "typescript": "~6.0.0"
  },
  "build": {
    "appId": "com.pdfviewer.editor",
    "productName": "PDF Viewer Editor",
    "directories": {
      "output": "dist/electron"
    },
    "files": [
      "dist/pdf-viewer-editor/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
